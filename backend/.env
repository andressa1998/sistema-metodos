# Banco de Dados
DB_HOST=seu-host.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=sua-senha

# JWT
JWT_SECRET=seu-segredo-super-secreto
JWT_EXPIRES_IN=7d

# Servidor
PORT=3002
NODE_ENV=production

# e-Social
ESOCIAL_AMBIENTE=homologacao
ESOCIAL_VERSAO=S-1.0
ESOCIAL_TIMEOUT=60

# Integração SOC
SOC_API_URL=https://api.soc.com.br
SOC_API_KEY=sua-chave-api

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha

# Logs
LOG_LEVEL=info
LOG_FILE=logs/esocial.log